{
  "title": "Operations Overview",
  "uid": "operations-overview",
  "tags": ["banking", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Request Rate by Service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "title": "HTTP Error Rate by Service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "title": "P50 Latency by Service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.50, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
        "legendFormat": "{{application}} P50"
      }]
    },
    {
      "title": "P95 Latency by Service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
        "legendFormat": "{{application}} P95"
      }]
    },
    {
      "title": "P99 Latency by Service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
        "legendFormat": "{{application}} P99"
      }]
    },
    {
      "title": "Pod CPU Utilisation",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"banking\", container!=\"\"}[1m]))",
        "legendFormat": "{{pod}}"
      }]
    },
    {
      "title": "Pod Memory Utilisation",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"banking\", container!=\"\"})",
        "legendFormat": "{{pod}}"
      }]
    },
    {
      "title": "HPA Current vs Desired Replicas",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"transaction-hpa\"}",
          "legendFormat": "Current Replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=\"transaction-hpa\"}",
          "legendFormat": "Max Replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"transaction-hpa\"}",
          "legendFormat": "Desired Replicas"
        }
      ]
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "kafka_consumergroup_lag{topic=\"banking-transactions\"}",
        "legendFormat": "{{consumergroup}}"
      }]
    },
    {
      "title": "Active PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum by (state) (pg_stat_activity_count{datname=\"bankingdb\"})",
        "legendFormat": "{{state}}"
      }]
    },
    {
      "title": "Active PostgreSQL Connections (Total)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(pg_stat_activity_count{datname=\"bankingdb\", state=\"active\"})",
        "legendFormat": "Active Connections"
      }]
    }
  ],
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"}
}